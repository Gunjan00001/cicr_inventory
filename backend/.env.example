# Server
PORT=5000
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Admin Authorization
MASTER_ADMIN_EMAIL=cicrinventory@gmail.com
SUPER_ADMIN_EMAILS=cicrinventory@gmail.com,admin@gmail.com

# Supabase (PRIMARY database — all reads and writes go here first)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Neon PostgreSQL (SECONDARY — async snapshot target + failover reads/writes; no dual-write)
NEON_PRIMARY_HOST=your-primary-endpoint.neon.tech
NEON_REPLICA_HOST=your-replica-endpoint.neon.tech
NEON_DATABASE=neondb
NEON_USER=your_neon_user
NEON_PASSWORD=your_neon_password
NEON_BRANCH_ID=your_branch_id
NEON_PROJECT_ID=your_project_id
NEON_API_KEY=your_neon_api_key

# JWT Authentication
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_ISSUER=
JWT_AUDIENCE=

# Redis (Upstash recommended — free tier at upstash.com)
# When set: persistent sessions, OTP caching, API response cache
# When empty: in-memory fallback (sessions lost on restart)
REDIS_URL=

# Express Session
SESSION_SECRET=your_session_secret_here

# Keep-Alive Service (prevents Supabase free-tier from sleeping)
# Interval in milliseconds (default: 3 days = 259200000)
KEEPALIVE_INTERVAL_MS=259200000
KEEPALIVE_ENABLED=true

# Supabase PRIMARY → Neon SECONDARY replication scheduler
# Async snapshot replication (users, inventory, audit_logs). Default 5 minutes.
REPLICATION_ENABLED=true
SYNC_INTERVAL_MS=300000

# Email Service (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="CICR Inventory Support" <your_email@gmail.com>

# Due-date reminder scheduler
REMINDERS_ENABLED=true
REMINDER_INTERVAL_MS=3600000
REMINDER_LEAD_HOURS=24
REMINDER_BATCH_LIMIT=100
REMINDER_CRON=0 9 * * *
